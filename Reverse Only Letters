class Solution:
    def reverseOnlyLetters(self, s: str) -> str:
        arr = list(s)
        l, r = 0, len(arr) - 1

        while l < r:
            if not arr[l].isalpha():
                l += 1
            elif not arr[r].isalpha():
                r -= 1
            else:
                arr[l], arr[r] = arr[r], arr[l]
                l += 1
                r -= 1

        return ''.join(arr)
